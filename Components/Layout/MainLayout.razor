@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<div class="page">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main>
        <header class="top-row px-4">
            <div class="top-row-right">
                <AuthorizeView>
                    <Authorized>
                        <span>Hola, @context.User.Identity?.Name</span>
                        <a href="/account/logout" class="logout-link">Cerrar Sesión</a>
                    </Authorized>
                    <NotAuthorized>
                         <a href="/signin-google" class="signin-link">Iniciar Sesión con Google</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>