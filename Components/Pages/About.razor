@page "/about"
@rendermode InteractiveServer
@inject PetStore.Services.LocalizationService L
@implements IDisposable

<PageTitle>@L["AboutPageTitle"]</PageTitle>

<h1>@L["AboutHeading"]</h1>

<p class="about-text">
  @L["AboutText"]
</p>

@code {
  protected override void OnInitialized()
  {
    L.LanguageChanged += HandleLanguageChanged;
  }

  private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

  public void Dispose()
  {
    L.LanguageChanged -= HandleLanguageChanged;
  }
}
