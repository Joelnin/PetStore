@page "/thankyou"
@using PetStore.Models
@inject PetStore.Data.PetStoreContext DbContext

<PageTitle>Success! | Pawsitive Friends</PageTitle>

<div class="thank-you-container">
  @if (application is null)
  {
    <div class="error-card animate-pop">
      <i class="bi bi-search-heart display-1 text-muted"></i>
      <h2>We couldn't find that application</h2>
      <p>Please double-check your link or contact our support team if you believe this is a mistake.</p>
      <NavLink href="/" class="btn-return">Return to Home</NavLink>
    </div>
  }
  else
  {
    <div class="success-card animate-pop">
      @* Cabecera de Celebración *@
      <header class="success-header">
        <div class="confetti-icon">
          <i class="bi bi-stars"></i>
        </div>
        <h1>You're a Hero, @FormatName(application.FullName)!</h1>
        <p class="subtitle">Your application for <strong>@application.PetName</strong> has been received.</p>
      </header>

      <div class="success-body">
        <div class="info-highlight">
          <i class="bi bi-send-check"></i>
          <p>
            We've forwarded your interest to <strong>@application.ShelterName</strong>.
            Their team will review your profile and reach out to you within
            <span class="wait-time">7 to 10 business days</span>.
          </p>
        </div>

        <section class="summary-box">
          <h3>Summary of your application</h3>
          <div class="summary-grid">
            <div class="summary-item">
              <label>Action</label>
              <p>@application.HelpType</p>
            </div>
            <div class="summary-item">
              <label>Pet</label>
              <p>@application.PetName</p>
            </div>
            <div class="summary-item">
              <label>Phone</label>
              <p>@FormatPhone(application.PhoneNumber)</p>
            </div>
            <div class="summary-item">
              <label>Email</label>
              <p>@application.Email</p>
            </div>
          </div>
        </section>

        <div class="next-steps">
          <p><i class="bi bi-info-circle"></i> Keep an eye on your email for the next steps!</p>
        </div>
      </div>

      <footer class="success-footer">
        <NavLink href="/" class="btn-home">
          <i class="bi bi-house-door-fill me-2"></i> Return to Home
        </NavLink>
      </footer>
    </div>
  }
</div>

@code {
  [Parameter]
  [SupplyParameterFromQuery]
  public int Id { get; set; }

  private ApplicationForm? application;

  protected override async Task OnParametersSetAsync()
  {
    // Use the Id from the query string to find the application
    application = await DbContext.ApplicationForms.FindAsync(Id);
  }

  // Formats each part of the name so the first letter is uppercase and the remaining letters are lowercase
  private string FormatName(string? fullName)
  {
    if (string.IsNullOrWhiteSpace(fullName))
      return string.Empty;

    var words = fullName
      .Trim()
      .Split(' ', StringSplitOptions.RemoveEmptyEntries);

    for (int i = 0; i < words.Length; i++)
    {
      var word = words[i].ToLower();

      words[i] = char.ToUpper(word[0]) + word.Substring(1);
    }

    return string.Join(" ", words);
  }

  // Format phone number
  private string FormatPhone(string? phone)
  {
    if (string.IsNullOrWhiteSpace(phone))
      return string.Empty;

    // Keep only numbers
    var digits = new string(phone.Where(char.IsDigit).ToArray());

    // If it's 10 digits, format it
    if (digits.Length == 10)
    {
      return $"{digits.Substring(0, 3)}-{digits.Substring(3, 3)}-{digits.Substring(6, 4)}";
    }

    // If not valid length, just return original
    return phone;
  }
}