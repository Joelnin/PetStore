@page "/management/applications/volunteers"
@rendermode InteractiveServer
@attribute [Authorize(Roles = Roles.Admin)]

@using PetStore.Models
@using PetStore.Services
@inject PetService PetService
@inject NavigationManager NavigationManager

<PageTitle>Volunteers | Admin</PageTitle>

<div class="admin-container">
  <nav class="navigation-path">
    <a href="/management" class="back-link">
      <i class="bi bi-arrow-left"></i> Back to Dashboard
    </a>
  </nav>

  <header class="page-header">
    <div class="header-content">
      <h1>Volunteer Applications</h1>
      <p>Review and manage people who want to join the Pawsitive Friends family.</p>
    </div>
    <div class="header-stats">
      <span class="stat-badge">Total: @applications.Count</span>
    </div>
  </header>

  <div class="table-responsive custom-card">
    <table class="table custom-table">
      <thead>
        <tr>
          <th>Volunteer Type</th>
          <th>Full Name</th>
          <th>Contact Info</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        @if (applications.Any())
        {
          @foreach (var app in applications)
          {
            <tr>
              <td>
                <span class="badge-type @app.VolunteerType.ToString().ToLower()">
                  @app.VolunteerType
                </span>
              </td>
              <td class="fw-bold">@app.Name</td>
              <td>
                <div class="contact-cell">
                  <span><i class="bi bi-envelope"></i> @app.Email</span>
                  <span><i class="bi bi-telephone"></i> @app.PhoneNumber</span>
                </div>
              </td>
              <td class="text-end">
                <button class="btn-delete" @onclick="() => DeleteApplication(app.Id)" title="Remove Application">
                  <i class="bi bi-trash3"></i>
                </button>
              </td>
            </tr>
          }
        }
        else
        {
          <tr>
            <td colspan="4" class="text-center py-5 text-muted">
              <i class="bi bi-inbox display-4 d-block mb-2"></i>
              No pending volunteer applications.
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>

@code {
  // Holds all pets displayed in table
  private List<VolunteerApplication> applications = new();

  // Loads the pets when the page first renders
  protected override void OnInitialized()
  {
    LoadApplications();
  }

  // Gets all pets from service/db and updates the table
  private void LoadApplications()
  {
    applications = PetService.GetAllVolunteers();
  }

  // Deletes the selected pet and refreshes the list
  private void DeleteApplication(int id)
  {
    PetService.DeleteVolunteer(id);
    LoadApplications();
  }
}