@page "/management/categories"
@rendermode InteractiveServer
@attribute [Authorize(Roles = Roles.Admin)]

@using PetStore.Models
@using PetStore.Services
@inject PetService PetService

<PageTitle>Categories | Admin</PageTitle>

<div class="admin-container">
  <nav class="navigation-path">
    <a href="/management/pets" class="back-link">
      <i class="bi bi-arrow-left"></i> Back to Pets
    </a>
  </nav>

  <div class="management-layout">
    @* Form *@
    <aside class="creation-sidebar">
      <div class="custom-card p-4">
        <h3 class="section-title"><i class="bi bi-tag-fill"></i> New Category</h3>
        <p class="text-muted small">Add a new pet classification to the system.</p>
                
        <EditForm Model="newCategory" OnValidSubmit="AddCategory">
          <DataAnnotationsValidator />
          <div class="mb-3">
            <label class="form-label fw-bold">Category Name</label>
            <InputText class="form-control" @bind-Value="newCategory.Name" placeholder="e.g. Exotic Birds" />
            <ValidationMessage class="text-danger small" For="@(() => newCategory.Name)" />
          </div>
          <button type="submit" class="btn btn-add-category w-100">
            <i class="bi bi-plus-circle me-2"></i> Add Category
          </button>
        </EditForm>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
          <div class="alert alert-danger mt-3 py-2 small shadow-sm">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
          </div>
        }
      </div>
    </aside>

    @* Edit Inline *@
    <main class="list-content">
      <div class="custom-card h-100">
        <div class="card-header-styled">
          <h2 class="m-0">Current Categories</h2>
          <span class="badge rounded-pill bg-light text-dark">@categories.Count Total</span>
        </div>

        <div class="table-responsive">
          <table class="table align-middle custom-table">
            <thead>
              <tr>
                <th>Name</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var category in categories)
              {
                <tr class="@(editCategory?.Id == category.Id ? "editing-row" : "")">
                  @if (editCategory?.Id == category.Id)
                  {
                    <td>
                      <InputText class="form-control form-control-sm edit-input" @bind-Value="editCategory.Name"
                                 @onkeyup="HandleKeyUp" />
                    </td>
                    <td class="text-end">
                      <div class="action-buttons">
                        <button class="btn-save-inline" @onclick="SaveEdit" title="Save Changes">
                          <i class="bi bi-check-lg"></i>
                        </button>
                        <button class="btn-cancel-inline" @onclick="CancelEdit" title="Cancel">
                          <i class="bi bi-x-lg"></i>
                        </button>
                      </div>
                    </td>
                  }
                  else
                  {
                    <td class="category-name-cell">
                      <i class="bi bi-hash text-muted me-2"></i>
                      @FormatCategoryName(category.Name)
                    </td>
                    <td class="text-end">
                      <div class="action-buttons">
                        <button class="btn-edit-inline" @onclick="() => StartEdit(category)" title="Edit Name">
                          <i class="bi bi-pencil"></i>
                        </button>
                        <button class="btn-delete-inline" @onclick="() => DeleteCategory(category.Id)"
                                title="Delete Category">
                          <i class="bi bi-trash3"></i>
                        </button>
                      </div>
                    </td>
                  }
                </tr>
              }
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>
</div>

@code {
  // Holds the new category being created from the form
  private PetCategory newCategory = new();

  // Stores the category being edited and is null when not being edited
  private PetCategory? editCategory;

  // List of all the categories displayed in the table
  private List<PetCategory> categories = new();

  // Error message shown to the admin (Example: delete restriction)
  private string errorMessage = "";

  // Load categories when page initializes
  protected override void OnInitialized()
  {
    LoadCategories();
  }

  // Gets all categories from service/db
  private void LoadCategories()
  {
    categories = PetService.GetAllCategories();
  }

  // Adds a new category and converts to lowercase for consistency
  private void AddCategory()
  {
    errorMessage = "";

    newCategory.Name = newCategory.Name.Trim().ToLower();

    PetService.AddCategory(newCategory);

    newCategory = new();
    LoadCategories();
  }

  // Begins editing mode for selected category. This will create a copy so changes aren't applied until saved
  private void StartEdit(PetCategory category)
  {
    errorMessage = "";

    editCategory = new PetCategory
    {
      Id = category.Id,
      Name = category.Name,
    };
  }

  // Saves the edited category and updates the list, while converting to lowercase for consistency
  private void SaveEdit()
  {
    if (editCategory == null) return;

    errorMessage = "";

    editCategory.Name = editCategory.Name.Trim().ToLower();

    PetService.UpdateCategory(editCategory);

    editCategory = null;

    LoadCategories();
  }

  // Cancels edit mode and resets state
  private void CancelEdit()
  {
    editCategory = null;
    errorMessage = "";
  }

  // Deletes a category as long as no pets are using; if there is a pet in the category, error message will display
  private void DeleteCategory(int id)
  {
    bool deleted = PetService.DeleteCategory(id);

    if (!deleted)
    {
      errorMessage = "Cannot delete this category because pets are still using it.";
    }
    else
    {
      errorMessage = "";
      LoadCategories();
    }
  }

  // Formats category names for display; capitalize the first letter and lowercase the rest of word
  private string FormatCategoryName(string name)
  {
    if (string.IsNullOrWhiteSpace(name))
      return "";

    return char.ToUpper(name[0]) + name.Substring(1).ToLower();
  }

  private void HandleKeyUp(KeyboardEventArgs e)
  {
    if (e.Key == "Enter")
    {
      SaveEdit(); // Guarda si presiona Enter
    }
    else if (e.Key == "Escape")
    {
      CancelEdit(); // Cancela si presiona Esc
    }
  }
}