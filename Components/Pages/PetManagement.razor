@page "/management/pets"
@rendermode InteractiveServer
@attribute [Authorize(Roles = Roles.Admin)]

@using PetStore.Models
@using PetStore.Services
@inject PetService PetService
@inject NavigationManager NavigationManager


<PageTitle>Pets Management | Admin</PageTitle>

<div class="admin-container">
  <nav class="navigation-path">
    <a href="/management" class="back-link">
      <i class="bi bi-arrow-left"></i> Back to Dashboard
    </a>
  </nav>

  <header class="page-header">
    <div class="header-content">
      <h1>Pet Management</h1>
      <p>Monitor and update the furry residents of our shelters.</p>
    </div>
    <div class="header-actions">
      <button class="btn-action secondary" @onclick="AddCategory">
        <i class="bi bi-tags"></i> Categories
      </button>
      <button class="btn-action primary" @onclick="CreatePet">
        <i class="bi bi-plus-lg"></i> Add New Pet
      </button>
    </div>
  </header>

  <div class="table-responsive custom-card">
    <table class="table custom-table align-middle">
      <thead>
        <tr>
          <th>Pet Details</th>
          <th>Attributes</th>
          <th class="text-center">Energy</th>
          <th>Status</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var pet in pets)
        {
          <tr>
            <td>
              <div class="pet-info">
                <span class="pet-name">@pet.Name</span>
                <span class="pet-breed">@pet.Type • @pet.Breed</span>
              </div>
            </td>
            <td>
              <div class="attribute-stack">
                <span class="attr-item"><i class="bi bi-calendar3"></i> @GetAge(pet.YearOfBirth) years old</span>
                <span class="attr-item" title="@GetShelterName(pet.Shelter_id)">
                  <i class="bi bi-house-heart"></i> @pet.Shelter_id
                </span>
              </div>
            </td>
            <td>
              <div class="energy-meter justify-content-center">
                @for (int i = 1; i <= 5; i++)
                {
                  <i class="bi bi-lightning-fill @(i <= pet.Energy ? "active" : "inactive")"></i>
                }
              </div>
            </td>
            <td>
              <div class="status-grid">
                <span class="status-pill @(pet.Is_Friendly ? "yes" : "no")">Friendly</span>
                <span class="status-pill @(pet.Is_Adopt ? "yes" : "no")">Adopt</span>
                <span class="status-pill @(pet.Is_Foster ? "yes" : "no")">Foster</span>
              </div>
            </td>
            <td class="text-end">
              <div class="action-buttons">
                <button class="btn-edit" @onclick="() => EditPet(pet.Id)" title="Edit Pet">
                  <i class="bi bi-pencil-square"></i>
                </button>
                <button class="btn-delete" @onclick="() => DeletePet(pet.Id)" title="Delete Pet">
                  <i class="bi bi-trash3"></i>
                </button>
              </div>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>

@code {
  // Holds all pets displayed in table
  private List<Pet> pets = new();

  // Loads the pets when the page first renders
  protected override void OnInitialized()
  {
    LoadPets();
  }

  // Gets all pets from service/db and updates the table
  private void LoadPets()
  {
    pets = PetService.GetAllPets();
  }

  // Takes admin to add pet page
  private void CreatePet()
  {
    NavigationManager.NavigateTo("/management/add");
  }

  // Takes admin to edit page for the selected pet
  private void EditPet(string id)
  {
    NavigationManager.NavigateTo($"/management/edit/{id}");
  }

  // Deletes the selected pet and refreshes the list
  private void DeletePet(string id)
  {
    PetService.DeletePet(id);
    LoadPets();
  }

  // Takes admin to the category management page
  private void AddCategory()
  {
    NavigationManager.NavigateTo("/management/categories");
  }

  // Converts a birth year into an approximate age.
  private int GetAge(int yearOfBirth)
  {
    return DateTime.Now.Year - yearOfBirth;
  }

  private string GetShelterName(string shelterId)
  {
    var shelter = PetService.GetShelterById(shelterId);
    return shelter?.Name ?? "Unknown Shelter";
  }
}