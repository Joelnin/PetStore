@page "/management/applications/helpers"
@rendermode InteractiveServer
@attribute [Authorize(Roles = Roles.Admin)]

@using PetStore.Models
@using PetStore.Services
@inject PetService PetService
@inject NavigationManager NavigationManager

<div class="admin-container">
  <nav class="navigation-path">
    <a href="/management" class="back-link">
      <i class="bi bi-arrow-left"></i> Back to Dashboard
    </a>
  </nav>

  <header class="page-header">
    <div class="header-content">
      <h1>Pet Specific Applications</h1>
      <p>Track contributions and support assigned to specific animals in our shelters.</p>
    </div>
    <div class="header-stats">
      <span class="stat-badge">Active Collaborations: @applications.Count</span>
    </div>
  </header>

  <div class="table-responsive custom-card">
    <table class="table custom-table align-middle">
      <thead>
        <tr>
          <th>Target Context</th>
          <th>Helper Details</th>
          <th>Contribution</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        @if (applications.Any())
        {
          @foreach (var app in applications)
          {
            <tr>
              <td>
                <div class="context-cell">
                  <span class="pet-target"><i class="bi bi-heart-pulse-fill"></i> @app.PetName</span>
                  <span class="shelter-location"><i class="bi bi-geo-alt"></i> @app.ShelterName</span>
                </div>
              </td>
              <td>
                <div class="helper-info">
                  <span class="helper-name">@app.FullName</span>
                  <span class="helper-address text-muted small">@app.Address</span>
                </div>
              </td>
              <td>
                <div class="help-type-tag">
                  <i class="bi bi-hand-thumbs-up"></i> @app.HelpType
                </div>
              </td>
              <td class="text-end">
                <div class="action-buttons-group">
                  <a href="/management/applications/helpers/@app.Id" class="btn-detail-view" title="View Full Profile">
                    <i class="bi bi-eye"></i> Details
                  </a>
                  <button class="btn-delete-icon" @onclick="() => DeleteApplication(app.Id)" title="Remove Record">
                    <i class="bi bi-trash3"></i>
                  </button>
                </div>
              </td>
            </tr>
          }
        }
        else
        {
          <tr>
            <td colspan="4" class="text-center py-5 no-data">
              <i class="bi bi-clipboard-x display-4 d-block mb-3"></i>
              <p>No specific helper applications found at the moment.</p>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>

@code {
  // Holds all applications displayed in table
  private List<ApplicationForm> applications = new();

  // Loads the applications when the page first renders
  protected override void OnInitialized()
  {
    LoadApplications();
  }

  // Gets all applications from service/db and updates the table
  private void LoadApplications()
  {
    applications = PetService.GetAllHelpers();
  }

  // Deletes the selected appliccation and refreshes the list
  private void DeleteApplication(int id)
  {
    PetService.DeleteHelper(id);
    LoadApplications();
  }
}