@page "/management/add"
@rendermode InteractiveServer
@attribute [Authorize(Roles = Roles.Admin)]

@using PetStore.Models
@using PetStore.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Authorization
@using System.IO

@inject PetService PetService
@inject NavigationManager NavigationManager
@inject IWebHostEnvironment Env

<PageTitle>Add New Pet | Admin</PageTitle>

<div class="form-container">
  <nav class="navigation-path">
    <a href="/management/pets" class="back-link">
      <i class="bi bi-arrow-left"></i> Back to List
    </a>
  </nav>

  <header class="form-header">
    <h1>Register New Pet</h1>
    <p>Fill in the details to add a new resident to the shelter.</p>
  </header>

  <EditForm Model="newPet" OnValidSubmit="SavePet" class="custom-form">
    <DataAnnotationsValidator />

    <div class="form-grid">
      <section class="form-section">
        <h3 class="section-title"><i class="bi bi-info-circle"></i> Basic Information</h3>
                
        <div class="mb-3">
          <label class="form-label fw-bold">Pet Name</label>
          <InputText class="form-control" @bind-Value="newPet.Name" placeholder="e.g. Buddy" />
          <ValidationMessage For="@(() => newPet.Name)" />
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Type</label>
            <InputSelect class="form-select" @bind-Value="newPet.Type">
              <option value="">Select Type</option>
              @foreach (var type in categories)
              {
                <option value="@type.Name">@type.Name</option>
              }
            </InputSelect>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Birth Year</label>
            <InputNumber class="form-control" @bind-Value="newPet.YearOfBirth" />
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label fw-bold">Breed</label>
          <InputText class="form-control" @bind-Value="newPet.Breed" placeholder="e.g. Golden Retriever" />
        </div>

        <div class="image-upload-zone">
          <label class="form-label fw-bold">Pet Photo</label>
          <div class="upload-controls">
            <InputFile id="petImageUpload" class="form-control mb-2" OnChange="HandleFileSelected" accept="image/*" />
            <InputText class="form-control" @bind-Value="newPet.ImageUrl" placeholder="Or paste Image URL" />
          </div>
          @if (!string.IsNullOrEmpty(newPet.ImageUrl))
          {
            <div class="image-preview mt-2">
              <img src="@newPet.ImageUrl" alt="Preview" />
            </div>
          }
        </div>
      </section>

      @* Details *@
      <section class="form-section">
        <h3 class="section-title"><i class="bi bi-stars"></i> Personality & Status</h3>

        <div class="mb-3">
          <label class="form-label fw-bold">Energy Level</label>
          <div class="energy-picker-container">
            <div class="energy-picker" @onmouseleave="ClearEnergyHover">
              @for (int i = 1; i <= 5; i++)
              {
                var level = i;
                <span class="energy-icon @(GetEnergyClass(level, newPet.Energy, hoverEnergy))"
                      @onclick="() => SetEnergy(level)" @onmouseenter="() => PreviewEnergy(level)">
                  <i class="bi bi-lightning-fill"></i>
                </span>
              }
            </div>
            <span class="energy-label">@(hoverEnergy > 0 ? hoverEnergy : newPet.Energy)/5</span>
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label fw-bold">Shelter Location</label>
          <InputSelect class="form-select" @bind-Value="newPet.Shelter_id">
            <option value="">Select Shelter</option>
            @foreach (var shelter in shelters)
            {
              <option value="@shelter.Id">@shelter.Name</option>
            }
          </InputSelect>
        </div>

        <div class="status-box">
          <label class="form-label fw-bold mb-3 d-block">Availability & Temperament</label>
          <div class="status-switches">
            <div class="form-check form-switch">
              <InputCheckbox id="friendly" class="form-check-input" @bind-Value="newPet.Is_Friendly" />
              <label for="friendly" class="form-check-label">Friendly Personality</label>
            </div>
            <div class="form-check form-switch">
              <InputCheckbox id="adoptable" class="form-check-input" @bind-Value="newPet.Is_Adopt" />
              <label for="adoptable" class="form-check-label">Ready for Adoption</label>
            </div>
            <div class="form-check form-switch">
              <InputCheckbox id="fosterable" class="form-check-input" @bind-Value="newPet.Is_Foster" />
              <label for="fosterable" class="form-check-label">Ready for Foster</label>
            </div>
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label fw-bold">Description / Story</label>
          <InputTextArea class="form-control" rows="4" @bind-Value="newPet.Description"
                         placeholder="Tell Buddy's story..." />
        </div>
      </section>
    </div>

    <div class="form-actions mt-4">
      <button type="button" class="btn btn-outline-secondary px-4 py-2" @onclick="Cancel">Cancel</button>
      <button type="submit" class="btn btn-primary px-5 py-2 fw-bold shadow-sm">
        <i class="bi bi-cloud-arrow-up-fill me-2"></i> Register Pet
      </button>
    </div>
  </EditForm>
</div>

@code {
  @* // Model bound to the form inputs
  [SupplyParameterFromForm] *@
  private Pet newPet { get; set; } = new();

  // List of pet categories loaded from the service
  private List<PetCategory> categories = new();

  // List of shelters loaded from service
  private List<Shelter> shelters = new();

  // Holds the uploaded file temporarily
  private IBrowserFile? selectedFile;

  // Message shown after selecting a file
  private string uploadMessage = "";

  // Load all categories and shelters when the page initializes
  protected override void OnInitialized()
  {
    categories = PetService.GetAllCategories();
    shelters = PetService.GetAllShelters();
  }

  // Handles file selection from the InputFile component.  Stores the file for later processing.
  private void HandleFileSelected(InputFileChangeEventArgs e)
  {
    selectedFile = e.File;

    uploadMessage = selectedFile is not null
      ? $"Selected file: {selectedFile.Name}"
      : "";
  }

  // Energy settings so admin can adjust energy level for pet
  private int? hoverEnergy;

  private void SetEnergy(int level)
  {
    newPet.Energy = level;
  }

  private void PreviewEnergy(int level)
  {
    hoverEnergy = level;
  }

  private void ClearEnergyHover()
  {
    hoverEnergy = null;
  }

  private string GetEnergyClass(int iconLevel, int selectedEnergy, int? hoverLevel)
  {
    var activeLevel = hoverLevel ?? selectedEnergy;
    return iconLevel <= activeLevel ? "filled" : "empty";
  }

  // Saves the pet to the database. If an image is uploaded, it is stored in wwwroot and linked. Otherwise, a default image is used.
  private async Task SavePet()
  {
    if (selectedFile is not null)
    {
      // Create folder path inside wwwroot for storing images
      var uploadsFolder = Path.Combine(Env.WebRootPath, "images", "pets");

      if (!Directory.Exists(uploadsFolder))
      {
        Directory.CreateDirectory(uploadsFolder);
      }

      // Generate unique file name to avoid overwriting
      var extension = Path.GetExtension(selectedFile.Name);
      var fileName = $"{Guid.NewGuid()}{extension}";
      var filePath = Path.Combine(uploadsFolder, fileName);

      // Save file with size limit (5 MB)
      await using FileStream fs = new(filePath, FileMode.Create);
      await selectedFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(fs);

      // Store relative path so the image can be displayed in the app
      newPet.ImageUrl = $"/images/pets/{fileName}";
    }
    else if (string.IsNullOrWhiteSpace(newPet.ImageUrl))
    {
      // Fallback image if no upload or URL is provided
      newPet.ImageUrl = "https://raw.githubusercontent.com/vsyang/pet-images/main/unavailable.jpg";
    }

    // Save pet using service
    PetService.AddPet(newPet);

    // Redirect back to management page
    NavigationManager.NavigateTo("/management");
  }

  // Cancels the operation and returns to management page.
  private void Cancel()
  {
    NavigationManager.NavigateTo("/management");
  }
}