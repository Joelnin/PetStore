@page "/management/edit/{id}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = Roles.Admin)]

@using PetStore.Models
@using PetStore.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Authorization
@using System.IO

@inject PetService PetService
@inject NavigationManager NavigationManager
@inject IWebHostEnvironment Env

<PageTitle>Management | Edit Pets</PageTitle>

<!-- This page is for editing pets already in the system -->
<h1>Edit Pet</h1>

@if (editPet is null)
{
  <p>Pet not found.</p>
}
else
{
  <PageTitle>Edit @editPet?.Name | Admin</PageTitle>

  <div class="form-container">
    <nav class="navigation-path">
      <a href="/management/pets" class="back-link">
        <i class="bi bi-arrow-left"></i> Back to Fleet
      </a>
    </nav>

    <header class="form-header">
      <div class="header-with-avatar">
        @if (!string.IsNullOrEmpty(editPet?.ImageUrl))
        {
          <img src="@editPet.ImageUrl" class="mini-avatar" alt="Pet Thumbnail" />
        }
        <div>
          <h1>Editing: @editPet?.Name</h1>
          <p>Update the records for this resident.</p>
        </div>
      </div>
    </header>

    @if (editPet == null)
    {
      <div class="spinner-container">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2">Loading pet data...</p>
      </div>
    }
    else
    {
      <EditForm Model="editPet" OnValidSubmit="SavePet" class="custom-form">
        <DataAnnotationsValidator />

        <div class="form-grid">
          <section class="form-section">
            <h3 class="section-title"><i class="bi bi-person-badge"></i> Identity</h3>
                    
            <div class="mb-3">
              <label class="form-label fw-bold">Pet Name</label>
              <InputText class="form-control form-control-lg" @bind-Value="editPet.Name" />
              <ValidationMessage For="@(() => editPet.Name)" />
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Type</label>
                <InputSelect class="form-select" @bind-Value="editPet.Type">
                  @foreach (var category in categories)
                  {
                    <option value="@category.Name">@category.Name</option>
                  }
                </InputSelect>
              </div>
              <div class="col-md-6 mb-3">
                <label class="form-label fw-bold">Birth Year</label>
                <InputNumber class="form-control" @bind-Value="editPet.YearOfBirth" />
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label fw-bold">Breed</label>
              <InputText class="form-control" @bind-Value="editPet.Breed" />
            </div>

            <div class="image-management-box">
              <label class="form-label fw-bold">Update Photo</label>
              <div class="current-image-wrapper mb-3">
                <img src="@editPet.ImageUrl" alt="Current Photo" class="img-fluid rounded-3 shadow-sm" />
              </div>
              <div class="upload-options">
                <InputFile id="newimage" class="form-control mb-2" OnChange="HandleFileSelected" accept="image/*" />
                <InputText class="form-control" @bind-Value="editPet.ImageUrl" placeholder="Or update Image URL" />
              </div>
            </div>
          </section>

          <section class="form-section">
            <h3 class="section-title"><i class="bi bi-gear-wide-connected"></i> Parameters</h3>

            <div class="mb-4">
              <label class="form-label fw-bold d-block">Energy Level</label>
              <div class="energy-picker-wrapper">
                <div class="energy-picker" @onmouseleave="ClearEnergyHover">
                  @for (int i = 1; i <= 5; i++)
                  {
                    var level = i;
                    <span class="energy-icon @(GetEnergyClass(level, editPet.Energy, hoverEnergy))"
                          @onclick="() => SetEnergy(level)" @onmouseenter="() => PreviewEnergy(level)">
                      <i class="bi bi-lightning-fill"></i>
                    </span>
                  }
                </div>
                <span class="badge bg-light text-dark ms-2">@(hoverEnergy > 0 ? hoverEnergy : editPet.Energy)/5</span>
              </div>
            </div>

            <div class="mb-4">
              <label class="form-label fw-bold">Assigned Shelter</label>
              <InputSelect class="form-select" @bind-Value="editPet.Shelter_id">
                @foreach (var shelter in shelters)
                {
                  <option value="@shelter.Id">@shelter.Name</option>
                }
              </InputSelect>
            </div>

            <div class="status-panel">
              <label class="form-label fw-bold mb-3 d-block">Visibility & Traits</label>
              <div class="switch-group">
                <div class="form-check form-switch custom-switch">
                  <InputCheckbox id="friendly" class="form-check-input" @bind-Value="editPet.Is_Friendly" />
                  <label for="friendly" class="form-check-label">Friendly Temperament</label>
                </div>
                <div class="form-check form-switch custom-switch">
                  <InputCheckbox id="adoption" class="form-check-input" @bind-Value="editPet.Is_Adopt" />
                  <label for="adoption" class="form-check-label">Active for Adoption</label>
                </div>
                <div class="form-check form-switch custom-switch">
                  <InputCheckbox id="foster" class="form-check-input" @bind-Value="editPet.Is_Foster" />
                  <label for="foster" class="form-check-label">Ready for Foster Care</label>
                </div>
              </div>
            </div>

            <div class="mt-4">
              <label class="form-label fw-bold">Biography</label>
              <InputTextArea class="form-control" rows="5" @bind-Value="editPet.Description" />
            </div>
          </section>
        </div>

        <div class="form-footer mt-5">
          <button type="button" class="btn btn-link text-muted" @onclick="Cancel">Discard Changes</button>
          <button type="submit" class="btn btn-save shadow">
            <i class="bi bi-check2-circle me-2"></i> Update Records
          </button>
        </div>
      </EditForm>
    }
  </div>
}

@code {
  [Parameter]
  public required string Id { get; set; }

  private Pet? editPet { get; set; }
  private List<PetCategory> categories = new();

  private List<Shelter> shelters = new();

  private IBrowserFile? selectedFile;
  private string uploadMessage = "";

  protected override void OnInitialized()
  {
    categories = PetService.GetAllCategories();
    shelters = PetService.GetAllShelters();

    var pet = PetService.GetPetById(Id);

    if (pet is not null)
    {
      editPet = new Pet
      {
        Id = pet.Id,
        Name = pet.Name,
        Type = pet.Type,
        Breed = pet.Breed,
        YearOfBirth = pet.YearOfBirth,
        Description = pet.Description,
        ImageUrl = pet.ImageUrl,
        Energy = pet.Energy,
        Shelter_id = pet.Shelter_id,
        Is_Friendly = pet.Is_Friendly,
        Is_Adopt = pet.Is_Adopt,
        Is_Foster = pet.Is_Foster
      };
    }
  }

  private void HandleFileSelected(InputFileChangeEventArgs e)
  {
    selectedFile = e.File;

    uploadMessage = selectedFile is not null
      ? $"Selected file: {selectedFile.Name}"
      : "";
  }

  // ENERGY LOGIC
  private int? hoverEnergy;

  private void SetEnergy(int level)
  {
    if (editPet is not null)
      editPet.Energy = level;
  }

  private void PreviewEnergy(int level)
  {
    hoverEnergy = level;
  }

  private void ClearEnergyHover()
  {
    hoverEnergy = null;
  }

  private string GetEnergyClass(int iconLevel, int selectedEnergy, int? hoverLevel)
  {
    var activeLevel = hoverLevel ?? selectedEnergy;
    return iconLevel <= activeLevel ? "filled" : "empty";
  }

  private async Task SavePet()
  {
    if (editPet is null) return;

    if (selectedFile is not null)
    {
      var uploadsFolder = Path.Combine(Env.WebRootPath, "images", "pets");

      if (!Directory.Exists(uploadsFolder))
        Directory.CreateDirectory(uploadsFolder);

      var extension = Path.GetExtension(selectedFile.Name);
      var fileName = $"{Guid.NewGuid()}{extension}";
      var filePath = Path.Combine(uploadsFolder, fileName);

      await using FileStream fs = new(filePath, FileMode.Create);
      await selectedFile.OpenReadStream(5 * 1024 * 1024).CopyToAsync(fs);

      editPet.ImageUrl = $"/images/pets/{fileName}";
    }
    else if (string.IsNullOrWhiteSpace(editPet.ImageUrl))
    {
      editPet.ImageUrl = "https://raw.githubusercontent.com/vsyang/pet-images/main/unavailable.jpg";
    }

    PetService.UpdatePet(editPet);
    NavigationManager.NavigateTo("/management");
  }

  private void Cancel()
  {
    NavigationManager.NavigateTo("/management");
  }
}