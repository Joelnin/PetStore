@page "/contact"
@rendermode InteractiveServer

<PageTitle>Contact Us</PageTitle>

<section class="contact-hero">
    <div class="contact-hero-content">
        <span class="contact-tag">Get in Touch</span>
        <h1>Contact Pawsitive Friends</h1>
        <p class="contact-lead">
            Have a question, need support, or want to learn more about adoption, fostering, or sponsorship?
            We'd love to hear from you.
        </p>
    </div>
</section>

<section class="contact-section">
    <div class="contact-grid">
        <div class="contact-info-card">
            <span class="section-label">Contact Information</span>
            <h2>We're Here to Help</h2>
            <p>
                Reach out to us for general inquiries, support, or more information about the platform.
                Our team is committed to making the experience simple, welcoming, and helpful.
            </p>

            <div class="contact-details">
                <div class="contact-item">
                    <h3>Email</h3>
                    <p>support@pawsitivefriends.com</p>
                </div>

                <div class="contact-item">
                    <h3>Phone</h3>
                    <p>+1 (000) 000-0000</p>
                </div>

                <div class="contact-item">
                    <h3>Location</h3>
                    <p>Available online for pet and shelter support</p>
                </div>

                <div class="contact-item">
                    <h3>Hours</h3>
                    <p>Monday - Friday, 9:00 AM - 5:00 PM</p>
                </div>
            </div>
        </div>
    </div>
</section>

@code {

}