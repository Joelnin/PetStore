@page "/"
@using PetStore.Services
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime
@inject PetService PetService
@inject LocalizationService L
@implements IAsyncDisposable
@implements IDisposable

<PageTitle>@L["HomeTitle"]</PageTitle>

<div class="container-centered">
    <div class="row align-items-center hero-split">
        <div class="col-lg-6 hero-text-section">
            <h1 class="display-4 fw-bold">@L["HomeHeroTitlePrefix"] <span class="text-highlight">@L["HomeHeroTitleHighlight"]</span></h1>
            <p class="lead mb-4">@L["HomeHeroDescription"]</p>

            <div class="selector-wrapper">
                <ShelterSelector Shelters="allShelters" OnShelterSelected="HandleShelterSelection" />
            </div>
        </div>

        <div class="col-lg-6 d-none d-lg-block">
            <div class="hero-image-container">
                <img src="images/heroes/default-hero-home.webp" alt="Pawsitive Friends Hero"
                     class="img-fluid hero-image appearing-image" @ref="heroImageRef" id="hero-dog-image" />
            </div>
        </div>
    </div>
</div>

<section class="container-centered">
    <div class="row g-4">
        <div class="col-md-4">
            <ActionCard Title="@L["Adopt"]" Description="@L["AdoptCardDescription"]"
                        LinkText="@L["ViewPets"]" TargetUrl="/pets" />
        </div>
        <div class="col-md-4">
            <ActionCard Title="@L["Donate"]" Description="@L["DonateCardDescription"]"
                        LinkText="@L["GiveToday"]" TargetUrl="/donate" />
        </div>
        <div class="col-md-4">
            <ActionCard Title="@L["Volunteer"]" Description="@L["VolunteerCardDescription"]"
                        LinkText="@L["JoinUs"]" TargetUrl="/volunteer" />
        </div>
    </div>
</section>

@if (!string.IsNullOrEmpty(selectedShelterId))
{
    <div class="container-centered mt-5">
        <div class="results-area p-4 rounded-3 bg-white shadow-sm border-start border-primary border-4">
            <p class="mb-0">@L["ShowingPetsForShelter"] <strong>@selectedShelterId</strong></p>
        </div>
    </div>
}
<section class="impact-section container-centered py-5">
    <div class="row align-items-center">
        <div class="col-lg-6 mb-5 mb-lg-0">
            <div class="impact-image-container">
                <img src="images/banner/our-mission.webp" alt="@L["OurMission"]" class="impact-img-3d" />
            </div>
        </div>

        <div class="col-lg-6 ps-lg-5 mission-text">
            <h2 class="section-title">@L["OurMission"]</h2>
            <p class="section-description">@L["MissionDescription"]</p>

            <GlobalStats />
        </div>
    </div>
</section>

<footer class="home-footer">
    <div class="container-centered footer-shell">
        <div class="row g-4">
            <div class="col-lg-4">
                <h3 class="footer-title">Pawsitive Friends</h3>
                <p class="footer-copy">@L["FooterBrandDescription"]</p>
                <div class="footer-socials">
                    <a href="https://www.facebook.com" target="_blank" class="footer-social-link" title="Facebook">
                        <i class="fab fa-facebook-f"></i>
                    </a>
                    <a href="https://www.instagram.com" target="_blank" class="footer-social-link" title="Instagram">
                        <i class="fab fa-instagram"></i>
                    </a>
                    <a href="https://www.linkedin.com" target="_blank" class="footer-social-link" title="LinkedIn">
                        <i class="fab fa-linkedin-in"></i>
                    </a>
                </div>
            </div>

            <div class="col-sm-6 col-lg-2">
                <h4 class="footer-heading">@L["Links"]</h4>
                <nav class="footer-links">
                    <a href="/">@GetHomeLabel()</a>
                    <a href="/about">@L["About"]</a>
                    <a href="/pets">@L["Pets"]</a>
                    <a href="/donate">@L["Donate"]</a>
                    <a href="/volunteer">@L["Volunteer"]</a>
                </nav>
            </div>

            <div class="col-sm-6 col-lg-3">
                <h4 class="footer-heading">@L["ContactUs"]</h4>
                <div class="footer-contact">
                    <a href="tel:+2348012345678">+234 801 234 5678</a>
                    <a href="mailto:hello@pawsitivefriends.org">hello@pawsitivefriends.org</a>
                    <p>@L["Hours"]</p>
                </div>
            </div>

            <div class="col-lg-3">
                <h4 class="footer-heading">@L["TermsAndConditions"]</h4>
                <p class="footer-copy small-copy">@L["TermsText"]</p>
            </div>
        </div>

        <div class="footer-bottom">
            <p class="mb-0">&copy; @DateTime.Now.Year Pawsitive Friends. @L["AllRightsReserved"]</p>
        </div>
    </div>
</footer>

@code {
    private ElementReference heroImageRef;
    private IJSObjectReference? scrollModule;
    private string selectedShelterId = string.Empty;
    private List<Shelter> allShelters = new();
    private string selectedId = string.Empty;

    protected override void OnInitialized()
    {
        L.LanguageChanged += HandleLanguageChanged;
        allShelters = PetService.GetAllShelters();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            scrollModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/heroScroll.js");
            await scrollModule.InvokeVoidAsync("initHeroScroll", "hero-dog-image");
        }
    }

    private void HandleShelterSelection(string id)
    {
        selectedId = id;
    }

    private string GetHomeLabel()
    {
        return L.CurrentLanguage switch
        {
            "Spanish" => "Inicio",
            "French" => "Accueil",
            "Portuguese" => "Início",
            _ => "Home"
        };
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        L.LanguageChanged -= HandleLanguageChanged;
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (scrollModule is not null)
        {
            await scrollModule.InvokeVoidAsync("disposeHeroScroll");
            await scrollModule.DisposeAsync();
        }
    }
}
