@using CountryData.Standard
@using PetStore.Models

<NavLink class="premium-shelter-card-wrapper" href="@($"/shelters/{Shelter.Id}")">
  <article class="premium-shelter-card">
        
    <div class="card-image-wrapper">
      <img src="@($"https://ghbvai4swfgyfpoi.public.blob.vercel-storage.com/{Shelter.Id}.png")" alt="@Shelter.Name"
           loading="lazy" />
    </div>

    <div class="card-content">
      <h3 class="shelter-title">@Shelter.Name</h3>
            
      <div class="shelter-meta">
        <i class="bi bi-geo-alt-fill text-emerald"></i>
        <span class="location-text">@GetCountry(Shelter.Country)</span>
        <i class="bi bi-arrow-right arrow-icon"></i>
      </div>
    </div>

  </article>
</NavLink>

@code {
  [Parameter] public Shelter Shelter { get; set; } = default!;

  private CountryHelper _helper = new CountryHelper();

  private string GetCountry(string code)
  {
    var country = _helper.GetCountryByCode(code);
    return country != null ? mayus(country.CountryName) : code;
  }

  private string mayus(string text)
  {
    if (string.IsNullOrEmpty(text)) return text;
    return char.ToUpper(text[0]) + text.Substring(1).ToLower();
  }
}